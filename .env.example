# Copie ce fichier vers .env et remplis les valeurs :
#   cp .env.example .env

# URL de connexion PostgreSQL (Neon, Railway, Supabase, etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/dbname?sslmode=require

# Clés VAPID pour les notifications push (générées avec `npx web-push generate-vapid-keys --json`)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# ── Supabase Realtime (optionnel) — propagation temps réel sans polling DB ──
# Crée un projet Supabase (gratuit) uniquement pour le Realtime Broadcast.
# La base reste Neon ; Supabase sert juste de pub/sub WebSocket.
# Si ces clés sont absentes, l'app retombe sur le SSE/polling existant.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Variables exposées au navigateur (préfixe NEXT_PUBLIC_) :
# même URL et même clé anon que ci-dessus.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
