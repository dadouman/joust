# Copie ce fichier vers .env et remplis les valeurs :
#   cp .env.example .env

# URL de connexion PostgreSQL (Neon, Railway, Supabase, etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/dbname?sslmode=require

# Clés VAPID pour les notifications push (générées avec `npx web-push generate-vapid-keys --json`)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# ── Supabase Realtime (optionnel) — propagation temps réel sans polling DB ──
# La base reste Neon ; Supabase sert juste de pub/sub WebSocket.
# Clé "publishable" (format sb_publishable_…) : sûr à exposer au navigateur.
# Si ces clés sont absentes, l'app retombe sur le SSE/polling existant.
SUPABASE_URL=https://ohxmgmztnihnqoqzemjj.supabase.co
SUPABASE_ANON_KEY=sb_publishable_votre_cle_ici

# Variables exposées au navigateur (préfixe NEXT_PUBLIC_) — mêmes valeurs.
NEXT_PUBLIC_SUPABASE_URL=https://ohxmgmztnihnqoqzemjj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_votre_cle_ici

# ── Lichess (POC invité sans association de compte) ──
# Deux comptes de test dont les tokens OAuth sont stockés côté serveur.
# Les tokens ne doivent JAMAIS être exposés au frontend ni commités.
# Création de tokens de test : https://lichess.org/account/oauth/token
#   scope 1 : challenge:write
#   scope 2 : board:play
# Seuls les DEUX TOKENS sont necessaires. Les pseudos sont detectes
# automatiquement via l'API /api/account au lancement du POC.
LICHESS_WHITE_TOKEN=lip_ton_token_blanc_ici
LICHESS_BLACK_TOKEN=lip_ton_token_noir_ici
